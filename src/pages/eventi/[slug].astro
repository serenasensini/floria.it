---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { eventImageFor, eventUrl, formatDate } from '../../lib/content';
import { site, pathFor, absoluteUrl } from '../../config/site';
export async function getStaticPaths() {
  return (await getCollection('events')).map((event) => ({ params: { slug: event.data.slug }, props: { event } }));
}
const { event } = Astro.props;
const e = event.data;
const images = e.images.map((image) => ({ src: eventImageFor(image.src), alt: image.alt }));
const image = await getImage({ src: images[0].src, width: 800, format: 'webp' });
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') }, { '@type': 'ListItem', position: 2, name: 'Eventi e sfilate', item: absoluteUrl('/eventi/') }, { '@type': 'ListItem', position: 3, name: e.title, item: new URL(eventUrl(event), site.url).href }] };
const eventData = { '@context': 'https://schema.org', '@type': 'Event', name: e.title, startDate: e.date.toISOString(), location: { '@type': 'Place', name: e.location }, description: e.description, image: new URL(image.src, site.url).href };
---
<BaseLayout title={`${e.title} | Eventi Floria`} description={e.description} structuredData={e.confirmed ? [breadcrumbs, eventData] : [breadcrumbs]}>
  <div class="wrap detail-wrap"><nav class="breadcrumbs" aria-label="Percorso di navigazione"><a href={pathFor("/")}>Home</a><span>/</span><a href={pathFor("/eventi/")}>Eventi e sfilate</a><span>/</span><span aria-current="page">{e.title}</span></nav>
    <div class="detail-grid"><div><Gallery images={images} /><p class="image-disclaimer">Immagine segnaposto</p></div><div class="detail-copy"><span class="eyebrow">{e.confirmed ? 'EVENTI E SFILATE' : 'EVENTO DIMOSTRATIVO'}</span><h1>{e.title}</h1><p class="lead">{e.description}</p><dl class="details-list"><div><dt>Data {e.confirmed ? '' : 'di esempio'}</dt><dd>{formatDate(e.date)}</dd></div><div><dt>Luogo</dt><dd>{e.location}</dd></div></dl>{!e.confirmed && <p class="demo-note">Questo evento non è confermato: testo e data sono esempi da sostituire.</p>}{e.url && <a class="text-link" href={e.url} target="_blank" rel="noopener noreferrer">Maggiori informazioni ↗</a>}<a class="back-link" href={pathFor("/eventi/")}>← Torna agli eventi</a></div></div>
  </div>
</BaseLayout>
